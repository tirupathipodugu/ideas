{
  "manifest_version": 3,
  "name": "Scroll Styles",
  "version": "0.1.0",
  "description": "Choose how your X feed moves: normal scrolling or turning pages like a book.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Scroll Styles",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["modes/catalog.js", "modes/default.js", "modes/page-roll.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
